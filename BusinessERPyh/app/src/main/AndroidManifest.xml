<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.mujeer.businesserp">

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:resizeableActivity="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".Developeractivity"
            android:label="Developer" />
		
		<activity
			android:name=".Paymentviewactivity"
			android:label="Payment" />

        <!-- Transactions -->
        <activity
            android:name=".Transactionactivity"
            android:label="Transactions" />

        <!-- Launcher: app opens straight to Add Sale > Add Item, so the
             user can start typing an item immediately. -->
        <activity
            android:name=".Transactioneditactivity"
            android:label="Transaction"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <activity
            android:name=".Transactionviewactivity"
            android:label="Transaction View" />

        <activity
            android:name=".BulkPurchaseImportActivity"
            android:label="Bulk Import" />

        <activity
            android:name=".BulkPurchaseImportErrorsActivity"
            android:label="Bulk Import Errors" />

        <!-- Payments -->
        <activity
            android:name=".Paymentactivity"
            android:label="Payments" />

        <activity
            android:name=".Paymenteditactivity"
            android:label="Payment" />

        <activity
            android:name=".Paymentviewactivity"
            android:label="Payment View" />

        <!-- Parties -->
        <activity
            android:name=".Partiesactivity"
            android:label="Parties" />

        <activity
            android:name=".Addpartyactivity"
            android:label="Add Party" />

        <activity
            android:name=".Partyviewactivity"
            android:label="Party" />

        <activity
            android:name=".Partieseditactivity"
            android:label="Edit Party" />

        <!-- Items -->
        <activity
            android:name=".Itemsactivity"
            android:label="Items" />

        <activity
            android:name=".Additemactivity"
            android:label="Add Item" />

        <activity
            android:name=".Itemviewactivity"
            android:label="Item" />

        <activity
            android:name=".Itemseditactivity"
            android:label="Edit Item" />
		
		<activity
			android:name=".Expensesactivity"
			android:exported="false" />

		<activity
			android:name=".Expenseeditactivity"
			android:exported="false" />

		<activity
			android:name=".Expenseviewactivity"
			android:exported="false" />
		
		
		<activity
			android:name=".Importexcelactivity"
			android:label="Importexcel" />

		<activity
			android:name=".ImportSkippedRowsActivity"
			android:label="Rows Not Imported" />

		<activity
			android:name=".ImportVyaparActivity"
			android:label="Import Vyapar Backup" />

		<activity
			android:name=".ImportVyaparSkippedRowsActivity"
			android:label="Rows Not Imported" />

        <!-- Reports -->
        <activity
            android:name=".Reportsactivity"
            android:label="Reports" />

        <activity
            android:name=".Salesreportactivity"
            android:label="Total Sales" />

        <activity
            android:name=".Partysalesreportactivity"
            android:label="Sales by Party" />

        <activity
            android:name=".Itemrankingreportactivity"
            android:label="Item Ranking" />

        <activity
            android:name=".Partyrankingreportactivity"
            android:label="Party Ranking" />

        <!-- Main (dashboard) -->
        <activity
            android:name=".MainActivity"
            android:label="@string/app_name" />

    </application>

</manifest>
