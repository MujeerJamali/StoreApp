<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView style="@style/PageTitle" android:text="Stock Take" />

    <TextView
        style="@style/FieldLabel"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="12dp"
        android:text="A physical count session - every active item's expected stock is snapshotted, you walk the shop entering what you actually counted, and finishing applies any difference as a real stock adjustment." />

    <LinearLayout
        android:id="@+id/group_no_session"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Button
            android:id="@+id/btn_start_stock_take"
            style="@style/AppButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start Stock Take" />

        <Button
            android:id="@+id/btn_stock_take_history"
            style="@style/AppButton.Outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Past Stock Takes" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/group_in_session"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_stock_take_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="0 of 0 counted"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/container_stock_take_lines"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </ScrollView>

        <Button
            android:id="@+id/btn_finish_stock_take"
            style="@style/AppButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Finish Stock Take" />

        <Button
            android:id="@+id/btn_cancel_stock_take"
            style="@style/AppButton.Danger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Cancel Stock Take" />

    </LinearLayout>

</LinearLayout>
