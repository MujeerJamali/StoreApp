<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView style="@style/PageTitle" android:text="Quick Sale" />

    <TextView
        android:id="@+id/tv_quick_sale_total"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Total: 0"
        android:textColor="@color/mod_sales"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        style="@style/FieldLabel"
        android:layout_marginTop="0dp"
        android:text="Quick Picks" />

    <LinearLayout
        android:id="@+id/container_quick_picks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <Button
        android:id="@+id/btn_quick_sale_add_any_item"
        style="@style/AppButton.Outline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="+ Add Any Item" />

    <TextView
        style="@style/FieldLabel"
        android:text="Cart" />

    <TextView
        android:id="@+id/tv_quick_sale_cart_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="Cart is empty - tap a quick pick above"
        android:textColor="@color/text_secondary"
        android:textSize="15sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/container_quick_sale_cart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

    <Button
        android:id="@+id/btn_complete_quick_sale"
        style="@style/AppButton"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="10dp"
        android:text="Complete Sale"
        android:textSize="18sp" />

</LinearLayout>
