<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="88dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Business ERP"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="20dp"
                android:text="Manage your business at a glance"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <!-- Row 1: Parties / Items -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_parties"
                    style="@style/DashboardCard"
                    android:layout_marginEnd="6dp"
                    android:drawableTop="@drawable/badge_parties"
                    android:text="Parties" />

                <Button
                    android:id="@+id/btn_items"
                    style="@style/DashboardCard"
                    android:layout_marginStart="6dp"
                    android:drawableTop="@drawable/badge_items"
                    android:text="Items" />

            </LinearLayout>

            <!-- Row 2: Purchases / Sales -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_transactions_purchase"
                    style="@style/DashboardCard"
                    android:layout_marginEnd="6dp"
                    android:drawableTop="@drawable/badge_purchase"
                    android:text="Purchases" />

                <Button
                    android:id="@+id/btn_transactions_sale"
                    style="@style/DashboardCard"
                    android:layout_marginStart="6dp"
                    android:drawableTop="@drawable/badge_sales"
                    android:text="Sales" />

            </LinearLayout>

            <!-- Row 3: Payments / Expenses -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_payments"
                    style="@style/DashboardCard"
                    android:layout_marginEnd="6dp"
                    android:drawableTop="@drawable/badge_payments"
                    android:text="Payments" />

                <Button
                    android:id="@+id/btn_expenses"
                    style="@style/DashboardCard"
                    android:layout_marginStart="6dp"
                    android:drawableTop="@drawable/badge_expenses"
                    android:text="Expenses" />

            </LinearLayout>

            <!-- Row 4: Reports -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_reports"
                    style="@style/DashboardCard"
                    android:drawableTop="@drawable/badge_reports"
                    android:text="Reports" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp"
                android:text="Tools"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Tools: a flat list card, deliberately distinct from the
                 module grid above so it reads as a secondary/utility
                 tier rather than another set of dashboard cards. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:elevation="@dimen/elevation_card"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btn_developer"
                    style="@style/ToolRow"
                    android:drawableStart="@drawable/badge_developer"
                    android:text="Developer" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/stroke" />

                <Button
                    android:id="@+id/btn_import"
                    style="@style/ToolRow"
                    android:drawableStart="@drawable/badge_import"
                    android:text="Import" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <Button
        android:id="@+id/btn_quick_add"
        android:layout_width="@dimen/fab_size"
        android:layout_height="@dimen/fab_size"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:background="@drawable/bg_fab"
        android:elevation="@dimen/elevation_fab"
        android:gravity="center"
        android:includeFontPadding="false"
        android:padding="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:text="+"
        android:textColor="@color/text_on_primary"
        android:textSize="28sp"
        android:textStyle="bold" />

</FrameLayout>
