<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="88dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Business ERP"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="16dp"
                android:text="Manage your business at a glance"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <!-- Global search: tapping it opens GlobalSearchActivity
                 rather than searching inline on an already-busy
                 Dashboard - see MainActivity's click listener below. -->
            <EditText
                android:id="@+id/et_dashboard_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="false"
                android:hint="Search parties, items, invoice numbers..."
                android:inputType="text|textNoSuggestions" />

            <!-- Favorites: long-press any Tool Row below (Modules or
                 Tools card) to pin/unpin it here - long-pressing a
                 pinned row here unpins it too. Hidden entirely when
                 nothing is pinned (see
                 MainActivity#refreshFavoritesCard()). Wrapped in one
                 outer block (with card_cash_summary/card_sales_trend
                 below) so Customize Dashboard can move the label and
                 its card together as a single reorderable unit - see
                 DashboardCardOrder/MainActivity#applyDashboardCardOrder(). -->
            <LinearLayout
                android:id="@+id/block_favorites"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/row_favorites_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tv_favorites_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:text="Favorites"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <com.mujeer.businesserp.InfoBubbleView
                        android:id="@+id/info_bubble_favorites"
                        android:layout_width="@dimen/info_bubble_size"
                        android:layout_height="@dimen/info_bubble_size" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/card_favorites"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_card"
                    android:elevation="@dimen/elevation_card"
                    android:orientation="vertical"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Cash summary: current cash-in-hand plus today/week/month
                 expense totals, computed live each time this screen is
                 shown (see MainActivity#loadCashSummary()). -->
            <LinearLayout
                android:id="@+id/card_cash_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_card"
                android:elevation="@dimen/elevation_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Cash in Hand"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <com.mujeer.businesserp.InfoBubbleView
                        android:id="@+id/info_bubble_cash"
                        android:layout_width="@dimen/info_bubble_size"
                        android:layout_height="@dimen/info_bubble_size" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tv_cash_balance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="0.00"
                    android:textColor="@color/text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Today's Expense"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_expense_today"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="0.00"
                            android:textColor="@color/danger"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="This Week"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_expense_week"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="0.00"
                            android:textColor="@color/danger"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="This Month"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_expense_month"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="0.00"
                            android:textColor="@color/danger"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- Sales trend sparkline: daily sales total for the last
                 7/30 days, including a day with zero sales - a quick
                 "is the shop busy lately" glance (see
                 MainActivity#loadSalesTrend()). -->
            <LinearLayout
                android:id="@+id/card_sales_trend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_card"
                android:elevation="@dimen/elevation_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Sales Trend"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <com.mujeer.businesserp.InfoBubbleView
                        android:id="@+id/info_bubble_sales_trend"
                        android:layout_width="@dimen/info_bubble_size"
                        android:layout_height="@dimen/info_bubble_size"
                        android:layout_marginEnd="8dp" />

                    <Spinner
                        android:id="@+id/spinner_sales_trend_horizon"
                        style="@style/FilterSpinner"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <com.mujeer.businesserp.SimpleBarChartView
                    android:id="@+id/chart_sales_trend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" />

                <!-- This period's Sales so far vs the same elapsed window
                     of the prior period - spinner_trend_compare_mode picks
                     Today vs Last Week (default; a week-ago weekday, not
                     yesterday, since a Monday is naturally busier/quieter
                     than a Sunday), This Week vs Last Week, or This Month
                     vs Last Month (see MainActivity#loadTodayVsLastWeek()). -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="10dp"
                    android:background="@color/stroke" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <Spinner
                            android:id="@+id/spinner_trend_compare_mode"
                            style="@style/FilterSpinner"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/tv_today_vs_last_week"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="0 vs 0"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_today_vs_last_week_change"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Consecutive-day sales streak - a small motivational
                     badge, not a report (see MainActivity#loadSalesStreak()
                     and DatabaseHelper.getSalesStreak()). -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="10dp"
                    android:background="@color/stroke" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_sales_streak"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="No sales streak yet"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_sales_streak_best"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Modules: plain one-line text rows, no icons - matches the
                 Tools list below instead of the old icon-grid cards. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:elevation="@dimen/elevation_card"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btn_parties"
                    style="@style/ToolRow"
                    android:text="Parties" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/stroke" />

                <Button
                    android:id="@+id/btn_items"
                    style="@style/ToolRow"
                    android:text="Items" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/stroke" />

                <Button
                    android:id="@+id/btn_transactions_purchase"
                    style="@style/ToolRow"
                    android:text="Purchases" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/stroke" />

                <Button
                    android:id="@+id/btn_transactions_sale"
                    style="@style/ToolRow"
                    android:text="Sales" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/stroke" />

                <Button
                    android:id="@+id/btn_payments"
                    style="@style/ToolRow"
                    android:text="Payments" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/stroke" />

                <Button
                    android:id="@+id/btn_expenses"
                    style="@style/ToolRow"
                    android:text="Expenses" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/stroke" />

                <Button
                    android:id="@+id/btn_reports"
                    style="@style/ToolRow"
                    android:text="Reports" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp"
                android:text="Tools"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Tools: a flat list card, deliberately distinct from the
                 module grid above so it reads as a secondary/utility
                 tier rather than another set of dashboard cards. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:elevation="@dimen/elevation_card"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btn_import"
                    style="@style/ToolRow"
                    android:text="Import" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/stroke" />

                <Button
                    android:id="@+id/btn_generate_entries"
                    style="@style/ToolRow"
                    android:text="Generate Entries" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/stroke" />

                <Button
                    android:id="@+id/btn_cash"
                    style="@style/ToolRow"
                    android:text="Cash" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/stroke" />

                <Button
                    android:id="@+id/btn_wanted_items"
                    style="@style/ToolRow"
                    android:text="Wanted Items" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/stroke" />

                <Button
                    android:id="@+id/btn_recurring_expenses"
                    style="@style/ToolRow"
                    android:text="Recurring Expenses" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/stroke" />

                <Button
                    android:id="@+id/btn_drafts"
                    style="@style/ToolRow"
                    android:text="Drafts" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/stroke" />

                <Button
                    android:id="@+id/btn_cost_items"
                    style="@style/ToolRow"
                    android:text="Cost Items" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/stroke" />

                <Button
                    android:id="@+id/btn_display_shoes"
                    style="@style/ToolRow"
                    android:text="Display Shoes" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/stroke" />

                <Button
                    android:id="@+id/btn_sample_shoes"
                    style="@style/ToolRow"
                    android:text="Sample Shoes" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/stroke" />

                <Button
                    android:id="@+id/btn_recently_deleted"
                    style="@style/ToolRow"
                    android:text="Recently Deleted" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/stroke" />

                <Button
                    android:id="@+id/btn_reorder_list"
                    style="@style/ToolRow"
                    android:text="Reorder List" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/stroke" />

                <Button
                    android:id="@+id/btn_bulk_item_update"
                    style="@style/ToolRow"
                    android:text="Bulk Item Update" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/stroke" />

                <Button
                    android:id="@+id/btn_loyalty_points"
                    style="@style/ToolRow"
                    android:text="Loyalty Points" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/stroke" />

                <Button
                    android:id="@+id/btn_stock_take"
                    style="@style/ToolRow"
                    android:text="Stock Take" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/stroke" />

                <Button
                    android:id="@+id/btn_quick_sale"
                    style="@style/ToolRow"
                    android:text="Quick Sale" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/stroke" />

                <Button
                    android:id="@+id/btn_today_actions"
                    style="@style/ToolRow"
                    android:text="What To Do Today" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/stroke" />

                <Button
                    android:id="@+id/btn_customize_dashboard"
                    style="@style/ToolRow"
                    android:text="Customize Dashboard" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/stroke" />

                <Button
                    android:id="@+id/btn_swipe_gesture_settings"
                    style="@style/ToolRow"
                    android:text="Swipe Gesture Settings" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <Button
        android:id="@+id/btn_quick_add"
        android:layout_width="@dimen/fab_size"
        android:layout_height="@dimen/fab_size"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:background="@drawable/bg_fab"
        android:elevation="@dimen/elevation_fab"
        android:gravity="center"
        android:includeFontPadding="false"
        android:padding="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:text="+"
        android:textColor="@color/text_on_primary"
        android:textSize="28sp"
        android:textStyle="bold" />

</FrameLayout>
