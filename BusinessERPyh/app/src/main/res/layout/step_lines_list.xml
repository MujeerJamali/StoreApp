<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tv_lines_title"
        style="@style/PageTitle"
        android:layout_margin="20dp"
        android:layout_marginBottom="0dp"
        android:text="Lines" />

    <TextView
        android:id="@+id/tv_lines_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:text="Nothing added yet. Tap &quot;Add Line&quot; to configure a party/amount and its dates."
        android:textColor="@color/text_hint"
        android:textSize="14sp" />

    <ListView
        android:id="@+id/lv_lines"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="8dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="4dp"
        android:clipToPadding="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="@dimen/elevation_card"
        android:orientation="horizontal"
        android:padding="16dp">

        <Button
            android:id="@+id/btn_add_line"
            style="@style/AppButton.Outline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="+ Add Line" />

        <Button
            android:id="@+id/btn_lines_continue"
            style="@style/AppButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="Review" />

    </LinearLayout>

</LinearLayout>
