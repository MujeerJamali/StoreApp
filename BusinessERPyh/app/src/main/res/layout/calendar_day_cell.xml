<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="@dimen/calendar_cell_size"
    android:layout_weight="1"
    android:layout_margin="2dp">

    <TextView
        android:id="@+id/tv_day_number"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="1"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tv_day_count"
        android:layout_width="@dimen/calendar_badge_size"
        android:layout_height="@dimen/calendar_badge_size"
        android:layout_gravity="top|end"
        android:background="@drawable/bg_calendar_count_badge"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="2"
        android:textColor="@color/text_on_primary"
        android:textSize="9sp"
        android:textStyle="bold"
        android:visibility="gone" />

</FrameLayout>
