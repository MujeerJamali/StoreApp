<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView style="@style/PageTitle" android:text="Recently Deleted" />

    <TextView
        android:id="@+id/tv_recently_deleted_description"
        style="@style/FieldLabel"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="12dp"
        android:text="Deleted Purchases and Sales stay here for 30 days. Tap a row to restore it, long-press to permanently delete it now." />

    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="Nothing in Recently Deleted."
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/lv_recently_deleted"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@android:color/transparent"
        android:dividerHeight="10dp"
        android:scrollbars="none" />

</LinearLayout>
