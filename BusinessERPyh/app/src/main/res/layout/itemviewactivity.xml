<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView style="@style/PageTitle" android:text="Item" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:elevation="@dimen/elevation_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                style="@style/FieldLabel"
                android:layout_marginTop="0dp"
                android:text="Code" />

            <TextView
                android:id="@+id/tv_item_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="A001"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />

            <TextView
                style="@style/FieldLabel"
                android:text="Name" />

            <TextView
                android:id="@+id/tv_item_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Item Name"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />

            <TextView
                style="@style/FieldLabel"
                android:text="Purchase Price" />

            <TextView
                android:id="@+id/tv_purchase_price"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0.00"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />

            <!-- Only shown when this item has one - see
                 DatabaseHelper#applyExtraCostToItem(). A weighted-average
                 transport/shipping cost per unit, blended in from past
                 purchases' Other Charges; counted in profit reports, not
                 in Stock Worth. -->
            <LinearLayout
                android:id="@+id/container_extra_cost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/FieldLabel"
                    android:text="Extra Cost/Unit (Transport/Shipping)" />

                <TextView
                    android:id="@+id/tv_extra_cost_per_unit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0.00"
                    android:textColor="@color/text_secondary"
                    android:textSize="17sp" />

            </LinearLayout>

            <!-- Only shown when this item has one - see
                 Itemseditactivity's Locations field. Free-form,
                 comma-separated bin/shelf tag(s). -->
            <LinearLayout
                android:id="@+id/container_locations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/FieldLabel"
                    android:text="Locations" />

                <TextView
                    android:id="@+id/tv_item_locations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/text_secondary"
                    android:textSize="17sp" />

            </LinearLayout>

            <TextView
                style="@style/FieldLabel"
                android:text="Sale Price" />

            <TextView
                android:id="@+id/tv_sale_price"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0.00"
                android:textColor="@color/success"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                style="@style/FieldLabel"
                android:text="Stock" />

            <TextView
                android:id="@+id/tv_item_stock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/mod_items"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Read-only breakdown of this item's stock by variety
             combination (e.g. "Red / M" -> 4). Hidden entirely when the
             item has no variety groups - rows are built dynamically in
             code, see Itemviewactivity#loadVarieties(). -->
        <LinearLayout
            android:id="@+id/card_varieties_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:elevation="@dimen/elevation_card"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Varieties"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/container_varieties_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

        </LinearLayout>

        <TextView
            style="@style/SectionTitle"
            android:layout_marginTop="24dp"
            android:text="Transactions" />

        <TextView
            android:id="@+id/tv_transactions_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="No transactions found."
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:visibility="gone" />

        <ListView
            android:id="@+id/lv_transactions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="10dp"
            android:scrollbars="none" />

        <Button
            android:id="@+id/btn_load_more_transactions"
            style="@style/AppButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Load More"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_edit_item"
                style="@style/AppButton.Outline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Edit Item" />

            <Button
                android:id="@+id/btn_delete_item"
                style="@style/AppButton.Danger"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Delete" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
