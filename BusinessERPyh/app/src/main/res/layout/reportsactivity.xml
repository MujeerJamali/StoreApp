<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/PageTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="0dp"
            android:text="Reports" />

        <com.mujeer.businesserp.InfoBubbleView
            android:id="@+id/info_bubble"
            android:layout_width="@dimen/info_bubble_size"
            android:layout_height="@dimen/info_bubble_size" />

    </LinearLayout>

    <!-- List of available reports: plain one-line text rows, no icons -
         styled like the dashboard's Tools card so it reads consistently
         with the rest of the app. New reports get added here as another
         ToolRow + divider pair (never with a drawableStart icon). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:elevation="@dimen/elevation_card"
        android:orientation="vertical">

        <Button
            android:id="@+id/btn_report_sales"
            style="@style/ToolRow"
            android:text="Total Sales by Period" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/stroke" />

        <Button
            android:id="@+id/btn_report_party_sales"
            style="@style/ToolRow"
            android:text="Sales by Party" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/stroke" />

        <Button
            android:id="@+id/btn_report_item_ranking"
            style="@style/ToolRow"
            android:text="Item Ranking (All Periods Combined)" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/stroke" />

        <Button
            android:id="@+id/btn_report_party_ranking"
            style="@style/ToolRow"
            android:text="Party Ranking (All Periods Combined)" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/stroke" />

        <Button
            android:id="@+id/btn_report_net_profit"
            style="@style/ToolRow"
            android:text="Net Profit by Period" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/stroke" />

        <Button
            android:id="@+id/btn_report_stock_worth"
            style="@style/ToolRow"
            android:text="Stock Worth" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/stroke" />

        <Button
            android:id="@+id/btn_report_party_balances"
            style="@style/ToolRow"
            android:text="Party Balances" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/stroke" />

        <Button
            android:id="@+id/btn_report_credit_due"
            style="@style/ToolRow"
            android:text="Credit Due" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/stroke" />

        <Button
            android:id="@+id/btn_report_low_stock"
            style="@style/ToolRow"
            android:text="Low Stock" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/stroke" />

        <Button
            android:id="@+id/btn_report_day_close"
            style="@style/ToolRow"
            android:text="Day Close" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/stroke" />

        <Button
            android:id="@+id/btn_report_cash_flow_forecast"
            style="@style/ToolRow"
            android:text="Cash Flow Forecast" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/stroke" />

        <Button
            android:id="@+id/btn_report_slow_moving_stock"
            style="@style/ToolRow"
            android:text="Slow-Moving Stock" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/stroke" />

        <Button
            android:id="@+id/btn_report_discount_stop_restock"
            style="@style/ToolRow"
            android:text="Discount &amp; Stop-Restocking" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/stroke" />

        <Button
            android:id="@+id/btn_report_month_over_month"
            style="@style/ToolRow"
            android:text="Month-over-Month" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/stroke" />

        <Button
            android:id="@+id/btn_report_item_monthly_rank"
            style="@style/ToolRow"
            android:text="Item Monthly Rank (Sales/Profit)" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/stroke" />

        <Button
            android:id="@+id/btn_report_average_cart"
            style="@style/ToolRow"
            android:text="Average Cart Size/Amount" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/stroke" />

        <Button
            android:id="@+id/btn_report_profit_split"
            style="@style/ToolRow"
            android:text="Profit: Cash Sale vs Party" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/stroke" />

        <Button
            android:id="@+id/btn_report_shoes_vs_non_shoes"
            style="@style/ToolRow"
            android:text="Shoes vs Non-Shoes" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/stroke" />

        <Button
            android:id="@+id/btn_report_combo_stock"
            style="@style/ToolRow"
            android:text="Combo/Variety Stock" />

    </LinearLayout>

    </LinearLayout>

    </ScrollView>

</FrameLayout>
