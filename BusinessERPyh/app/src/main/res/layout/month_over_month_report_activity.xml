<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView style="@style/PageTitle" android:text="Month-over-Month" />

        <TextView
            android:id="@+id/tv_month_labels"
            style="@style/FieldLabel"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="12dp"
            android:text="This Month vs Last Month" />

        <LinearLayout
            android:id="@+id/row_sales"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card"
            android:elevation="@dimen/elevation_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView style="@style/FieldLabel" android:layout_marginTop="0dp" android:text="Sales" />

            <TextView
                android:id="@+id/tv_sales_this"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="This Month: 0.00"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_sales_last"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Last Month: 0.00"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_sales_delta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="No change"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_profit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card"
            android:elevation="@dimen/elevation_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView style="@style/FieldLabel" android:layout_marginTop="0dp" android:text="Net Profit" />

            <TextView
                android:id="@+id/tv_profit_this"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="This Month: 0.00"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_profit_last"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Last Month: 0.00"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_profit_delta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="No change"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_expenses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_card"
            android:elevation="@dimen/elevation_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView style="@style/FieldLabel" android:layout_marginTop="0dp" android:text="Expenses" />

            <TextView
                android:id="@+id/tv_expenses_this"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="This Month: 0.00"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_expenses_last"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Last Month: 0.00"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_expenses_delta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="No change"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

        <com.mujeer.businesserp.SimpleBarChartView
            android:id="@+id/chart_month_over_month"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>

</ScrollView>
