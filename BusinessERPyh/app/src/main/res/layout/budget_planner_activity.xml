<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/PageTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="0dp"
            android:text="Budget Planner" />

        <com.mujeer.businesserp.InfoBubbleView
            android:id="@+id/info_bubble"
            android:layout_width="@dimen/info_bubble_size"
            android:layout_height="@dimen/info_bubble_size" />

    </LinearLayout>

    <TextView
        style="@style/FieldLabel"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="12dp"
        android:text="What next month's purchases would cost if every current Reorder List suggestion were bought, vs what's actually available to spend." />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:elevation="@dimen/elevation_card"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView style="@style/FieldLabel" android:layout_marginTop="0dp" android:text="Available Cash" />
        <TextView
            android:id="@+id/tv_available_cash"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView style="@style/FieldLabel" android:text="Total Suggested Purchases" />
        <TextView
            android:id="@+id/tv_total_suggested"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView style="@style/FieldLabel" android:text="Remaining After Covering All of It" />
        <TextView
            android:id="@+id/tv_remaining"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <TextView
        style="@style/SectionTitle"
        android:layout_marginTop="20dp"
        android:text="By Supplier" />

    <TextView
        android:id="@+id/tv_no_suggestions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="Nothing on the Reorder List right now."
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/container_budget_by_supplier"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

</LinearLayout>
