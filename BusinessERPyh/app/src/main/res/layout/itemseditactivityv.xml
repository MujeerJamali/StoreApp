<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView style="@style/PageTitle" android:text="Edit Item" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:elevation="@dimen/elevation_card"
            android:orientation="vertical"
            android:padding="18dp">

            <CheckBox
                android:id="@+id/cb_is_shoe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="This is a shoe (Gender/Type/Sole/Upper/Design/Color/Size)" />

            <TextView
                android:id="@+id/tv_item_name_label"
                style="@style/FieldLabel"
                android:layout_marginTop="0dp"
                android:text="Item Name" />
            <EditText
                android:id="@+id/et_item_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
        android:inputType="text|textNoSuggestions"
        />

            <LinearLayout
                android:id="@+id/container_shoe_fields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView style="@style/FieldLabel" android:text="Gender" />
                <EditText
                    android:id="@+id/et_shoe_gender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g. Men"
                    android:inputType="text|textNoSuggestions" />

                <TextView style="@style/FieldLabel" android:text="Type" />
                <EditText
                    android:id="@+id/et_shoe_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g. Sneaker"
                    android:inputType="text|textNoSuggestions" />

                <TextView style="@style/FieldLabel" android:text="Sole" />
                <EditText
                    android:id="@+id/et_shoe_sole"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g. Rubber"
                    android:inputType="text|textNoSuggestions" />

                <TextView style="@style/FieldLabel" android:text="Upper" />
                <EditText
                    android:id="@+id/et_shoe_upper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g. Leather"
                    android:inputType="text|textNoSuggestions" />

                <TextView style="@style/FieldLabel" android:text="Design" />
                <EditText
                    android:id="@+id/et_shoe_design"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g. Classic"
                    android:inputType="text|textNoSuggestions" />

                <TextView style="@style/FieldLabel" android:text="Color" />
                <EditText
                    android:id="@+id/et_shoe_color"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g. Black"
                    android:inputType="text|textNoSuggestions" />

                <TextView style="@style/FieldLabel" android:text="Size" />
                <EditText
                    android:id="@+id/et_shoe_size"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g. 42"
                    android:inputType="text|textNoSuggestions" />

                <TextView
                    style="@style/FieldLabel"
                    android:text="Each field above must be a single word (no spaces) - they're joined together to build the item name." />

            </LinearLayout>

            <TextView style="@style/FieldLabel" android:text="Purchase Price" />
            <EditText
                android:id="@+id/et_purchase_price"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />

            <TextView style="@style/FieldLabel" android:text="Sale Price" />
            <EditText
                android:id="@+id/et_sale_price"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />

            <TextView style="@style/FieldLabel" android:text="Current Stock" />
            <TextView
                android:id="@+id/tv_item_stock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/mod_items"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView style="@style/FieldLabel" android:text="Reorder Threshold" />
            <EditText
                android:id="@+id/et_reorder_threshold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="0 = no Low Stock alert"
                android:inputType="numberDecimal" />

            <TextView style="@style/FieldLabel" android:text="Locations" />
            <EditText
                android:id="@+id/et_item_locations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g. Shelf A, Bin 12"
                android:inputType="text" />

            <CheckBox
                android:id="@+id/cb_active"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:checked="true"
                android:text="Active (inactive items are hidden from item pickers)" />

            <CheckBox
                android:id="@+id/cb_holiday_seasonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Holiday/gift-driven item (toys, decorations, etc.) - boosts reorder suggestions heading into Oct-Dec" />

        </LinearLayout>

        <!-- Optional stock-keeping groups (e.g. Size, Color). Hidden until
             the item exists (a new item has no id to attach groups to
             until it's saved once). Group/value rows are built dynamically
             in code - see Itemseditactivity#loadVarieties(). -->
        <LinearLayout
            android:id="@+id/card_varieties"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:elevation="@dimen/elevation_card"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Varieties"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Optional stock-keeping groups, e.g. Size or Color."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/container_varieties"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <Button
                android:id="@+id/btn_add_variety_group"
                style="@style/AppButton.Outline.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="+ Add Group" />

        </LinearLayout>

        <Button
            android:id="@+id/btn_update_item"
            style="@style/AppButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Update Item" />

    </LinearLayout>

</ScrollView>
