<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tv_dialog_title"
        style="@style/SectionTitle"
        android:layout_width="match_parent"
        android:text="Add Item" />

    <TextView style="@style/FieldLabel" android:layout_marginTop="16dp" android:text="Item" />
    <AutoCompleteTextView
        android:id="@+id/actv_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_input"
        android:hint="Select Item"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint"
        android:textSize="15sp" 
        android:inputType="text|textNoSuggestions"
        />

    <!-- One label+Spinner pair per variety group of the selected item,
         built dynamically in code (Transactioneditactivity#populateVarietySpinners).
         Empty and gone for an item with no variety groups. -->
    <LinearLayout
        android:id="@+id/container_dialog_varieties"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone" />

    <TextView style="@style/FieldLabel" android:text="Quantity" />
    <EditText
        android:id="@+id/et_quantity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="numberDecimal" />

    <TextView style="@style/FieldLabel" android:text="Purchase Price" />
    <EditText
        android:id="@+id/et_purchase_price"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="numberDecimal" />

    <!-- Editing this recalculates the price above for the current
         quantity (e.g. 4 @ 50 = 200; changing this to 100 sets price to
         25) - see Transactioneditactivity#wireQuantityPriceTotalSync. -->
    <TextView style="@style/FieldLabel" android:text="Total" />
    <EditText
        android:id="@+id/et_item_total"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="numberDecimal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_dialog_cancel"
            style="@style/AppButton.Outline.Small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="Cancel" />

        <Button
            android:id="@+id/btn_dialog_confirm"
            style="@style/AppButton.Small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="Add" />

        <!--
            Only shown for the "Add Item" dialog (showAddTransactionItemDialog);
            stays GONE for the "Edit Item" dialog (showEditTransactionItem) since
            "add another" doesn't apply there. When GONE it takes no width, so
            the two buttons above simply split the row evenly.
        -->
        <Button
            android:id="@+id/btn_dialog_add_new"
            style="@style/AppButton.Outline.Small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="Add &amp; New"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
