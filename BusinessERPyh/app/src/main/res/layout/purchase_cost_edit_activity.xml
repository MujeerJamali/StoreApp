<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView style="@style/PageTitle" android:text="Purchase Cost" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:elevation="@dimen/elevation_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView style="@style/FieldLabel" android:layout_marginTop="0dp" android:text="Cost Item" />
            <AutoCompleteTextView
                android:id="@+id/actv_cost_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:hint="e.g. Petrol, Shipping, Packaging"
                android:inputType="text|textNoSuggestions"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="13dp"
                android:paddingBottom="13dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="15sp" />

            <TextView style="@style/FieldLabel" android:text="Amount" />
            <EditText
                android:id="@+id/et_pc_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Total amount"
                android:inputType="numberDecimal" />

            <!-- Single-purchase mode only (opened via "+ Add Purchase Cost"
                 from a purchase not yet saved, so there's nothing to pick
                 from in Split Across Purchase(s) below) - see
                 PurchaseCostEditActivity#singlePurchaseMode. -->
            <CheckBox
                android:id="@+id/cb_pc_to_party"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:checked="true"
                android:text="Add to amount owed to supplier (instead of cash now)"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/FieldLabel" android:text="Date" />
                    <EditText
                        android:id="@+id/et_pc_date"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="false"
                        android:hint="Date" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/FieldLabel" android:text="Time" />
                    <EditText
                        android:id="@+id/et_pc_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="false"
                        android:hint="Time" />

                </LinearLayout>

            </LinearLayout>

            <TextView style="@style/FieldLabel" android:text="Notes (optional)" />
            <EditText
                android:id="@+id/et_pc_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Notes"
                android:inputType="text|textNoSuggestions" />

        </LinearLayout>

        <!-- New-entry mode only: pick which existing purchase(s) this
             cost splits across. Hidden once the entry already exists,
             since a saved entry's split isn't retroactively editable -
             see PurchaseCostEditActivity#loadExistingCost(). -->
        <LinearLayout
            android:id="@+id/container_purchase_picker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <TextView style="@style/FieldLabel" android:layout_marginTop="0dp" android:text="Split Across Purchase(s)" />

            <EditText
                android:id="@+id/et_search_purchases"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_search"
                android:hint="Search by party or invoice..."
                android:inputType="text|textNoSuggestions"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="15sp" />

            <ListView
                android:id="@+id/lv_purchase_picker"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:divider="@color/stroke"
                android:dividerHeight="1dp"
                android:elevation="@dimen/elevation_card" />

        </LinearLayout>

        <!-- Existing-entry mode only: read-only summary of how this
             entry's amount was already split, filled in code from
             DatabaseHelper#getPurchaseCostLinks(). -->
        <LinearLayout
            android:id="@+id/container_existing_links"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:elevation="@dimen/elevation_card"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <TextView style="@style/FieldLabel" android:layout_marginTop="0dp" android:text="Applied To" />

            <LinearLayout
                android:id="@+id/container_existing_links_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

        <Button
            android:id="@+id/btn_save_purchase_cost"
            style="@style/AppButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Save" />

        <Button
            android:id="@+id/btn_delete_purchase_cost"
            style="@style/AppButton.Danger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Delete"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>
