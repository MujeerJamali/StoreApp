<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView style="@style/PageTitle" android:text="Export Vyapar Backup" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:text="Saves everything in this app - parties, items, purchases, sales, payments, party transfers, and expenses - into a .vyb file in the same format &quot;Restore Vyapar Backup&quot; reads. Use it to back up this device or move your data to another install; restoring it back into this same app will replace everything with this snapshot."
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Backup health check (approved feature "last successful backup:
         X days ago" warning) - a visible, always-there readout rather
         than only the silent 7-day-overdue notification
         (BackupReminderNotifier) that already existed. See
         ExportVyaparActivity#applyBackupHealthStatus(). -->
    <TextView
        android:id="@+id/tv_backup_health"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_chip"
        android:padding="10dp"
        android:text="Never backed up yet"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btn_export_vyb"
        style="@style/AppButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Export to .vyb File" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_card"
        android:elevation="@dimen/elevation_card"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/SectionTitle"
            android:layout_marginTop="0dp"
            android:text="Cloud Backup" />

        <TextView
            android:id="@+id/tv_drive_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="6dp"
            android:text="Not connected. Backups are not copied to the cloud."
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- Shown only once connected - proof the automatic side is
             actually working, not just that a folder was picked once.
             See ExportVyaparActivity#applyCloudBackupHealthStatus(). -->
        <TextView
            android:id="@+id/tv_cloud_backup_health"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_chip"
            android:padding="10dp"
            android:text="No cloud backup yet"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_connect_drive"
            style="@style/AppButton.Outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Connect Google Drive" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_card"
        android:elevation="@dimen/elevation_card"
        android:orientation="vertical"
        android:padding="16dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/tv_export_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ready..."
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />

        </ScrollView>

    </LinearLayout>

</LinearLayout>
