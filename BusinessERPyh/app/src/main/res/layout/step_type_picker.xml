<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            style="@style/PageTitle"
            android:layout_marginBottom="0dp"
            android:text="Generate Entries" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="Pick what you want to generate, then tap dates on a calendar to build up entries in bulk."
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_type_purchase"
                style="@style/DashboardCard"
                android:layout_marginEnd="6dp"
                android:drawableTop="@drawable/badge_purchase"
                android:text="Purchase" />

            <Button
                android:id="@+id/btn_type_sale"
                style="@style/DashboardCard"
                android:layout_marginStart="6dp"
                android:drawableTop="@drawable/badge_sales"
                android:text="Sale" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_type_payment"
                style="@style/DashboardCard"
                android:layout_marginEnd="6dp"
                android:drawableTop="@drawable/badge_payments"
                android:text="Payment" />

            <Button
                android:id="@+id/btn_type_expense"
                style="@style/DashboardCard"
                android:layout_marginStart="6dp"
                android:drawableTop="@drawable/badge_expenses"
                android:text="Expense" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
