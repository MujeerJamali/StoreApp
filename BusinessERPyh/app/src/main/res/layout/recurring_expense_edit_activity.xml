<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView style="@style/PageTitle" android:text="Recurring Expense" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:elevation="@dimen/elevation_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView style="@style/FieldLabel" android:layout_marginTop="0dp" android:text="Expense Item" />
            <EditText
                android:id="@+id/et_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g. Shop Rent"
                android:inputType="text|textNoSuggestions" />

            <TextView style="@style/FieldLabel" android:text="Amount" />
            <EditText
                android:id="@+id/et_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Amount"
                android:inputType="numberDecimal" />

            <TextView style="@style/FieldLabel" android:text="Party (optional)" />
            <AutoCompleteTextView
                android:id="@+id/actv_party"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:hint="Who this is paid to"
                android:inputType="text|textNoSuggestions"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="13dp"
                android:paddingBottom="13dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="15sp" />

            <TextView style="@style/FieldLabel" android:text="Repeats" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_freq_daily"
                    style="@style/AppButton.Small"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="Daily" />

                <Button
                    android:id="@+id/btn_freq_weekly"
                    style="@style/AppButton.Outline.Small"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="Weekly" />

                <Button
                    android:id="@+id/btn_freq_monthly"
                    style="@style/AppButton.Outline.Small"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="Monthly" />

                <Button
                    android:id="@+id/btn_freq_specific"
                    style="@style/AppButton.Outline.Small"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="Specific Dates" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/container_weekly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView style="@style/FieldLabel" android:text="Day of Week" />
                <Spinner
                    android:id="@+id/spinner_day_of_week"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/container_monthly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView style="@style/FieldLabel" android:text="Day of Month (1-31)" />
                <EditText
                    android:id="@+id/et_day_of_month"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g. 1"
                    android:inputType="number" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/container_specific"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView style="@style/FieldLabel" android:text="Dates" />
                <EditText
                    android:id="@+id/et_specific_dates"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Tap Add Date below, or edit directly"
                    android:inputType="text|textNoSuggestions" />

                <Button
                    android:id="@+id/btn_add_specific_date"
                    style="@style/AppButton.Outline.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Add Date" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/container_start_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView style="@style/FieldLabel" android:text="Starts From" />
                <EditText
                    android:id="@+id/et_start_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="false"
                    android:hint="Start date"
                    android:inputType="text|textNoSuggestions" />

            </LinearLayout>

            <TextView style="@style/FieldLabel" android:text="Notes (optional)" />
            <EditText
                android:id="@+id/et_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Notes"
                android:inputType="text|textNoSuggestions" />

            <CheckBox
                android:id="@+id/cb_active"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:checked="true"
                android:text="Active" />

        </LinearLayout>

        <Button
            android:id="@+id/btn_save"
            style="@style/AppButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Save" />

        <Button
            android:id="@+id/btn_delete"
            style="@style/AppButton.Danger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Delete"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>
