<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/PageTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="0dp"
                android:text="Stock Value" />

            <com.mujeer.businesserp.InfoBubbleView
                android:id="@+id/info_bubble"
                android:layout_width="@dimen/info_bubble_size"
                android:layout_height="@dimen/info_bubble_size" />

        </LinearLayout>

        <TextView
            style="@style/FieldLabel"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="12dp"
            android:text="Where your money is tied up in current stock, sliced by category (the first word of each item's name) and by how long since it last sold." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:elevation="@dimen/elevation_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView style="@style/FieldLabel" android:layout_marginTop="0dp" android:text="Total Stock Value" />

            <TextView
                android:id="@+id/tv_total_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/mod_items"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="By Category"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Pie when at least 2 categories hold positive value (a true
             share-of-whole); Bar as the fallback for a single category -
             see applyCategoryChart()'s own comment. -->
        <com.mujeer.businesserp.SimplePieChartView
            android:id="@+id/chart_stock_value_pie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <com.mujeer.businesserp.SimpleBarChartView
            android:id="@+id/chart_stock_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:id="@+id/container_by_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:elevation="@dimen/elevation_card"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="By Age (days since last sale)"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/container_by_age"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:elevation="@dimen/elevation_card"
            android:orientation="vertical" />

    </LinearLayout>

</ScrollView>
