<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView style="@style/PageTitle" android:text="Total Sales" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_range_today"
                style="@style/AppButton.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:minWidth="0dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="Today" />

            <Button
                android:id="@+id/btn_range_week"
                style="@style/AppButton.Outline.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:minWidth="0dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="Week" />

            <Button
                android:id="@+id/btn_range_month"
                style="@style/AppButton.Outline.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:minWidth="0dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="Month" />

            <Button
                android:id="@+id/btn_range_quarter"
                style="@style/AppButton.Outline.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:minWidth="0dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="Quarter" />

            <Button
                android:id="@+id/btn_range_year"
                style="@style/AppButton.Outline.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="Year" />

        </LinearLayout>

    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:elevation="@dimen/elevation_card"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/tv_range_label"
            style="@style/FieldLabel"
            android:layout_marginTop="0dp"
            android:text="Today" />

        <TextView
            android:id="@+id/tv_total_sales"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0.00"
            android:textColor="@color/mod_sales"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_date_range"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="-"
            android:textColor="@color/text_hint"
            android:textSize="12sp" />

        <TextView
            style="@style/FieldLabel"
            android:text="Number of Sales" />

        <TextView
            android:id="@+id/tv_sales_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
